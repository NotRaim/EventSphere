# Netlify environment variables (set these in Netlify UI, not in this file)
NODE_ENV=production
PAYMENT_MODE=demo
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d
TICKET_SIGNING_SECRET=YOUR_LONG_RANDOM_TICKET_SECRET
ADMIN_NAME=EventSphere Admin
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
CLIENT_ORIGIN=https://YOUR-SITE-NAME.netlify.app
PUBLIC_BASE_URL=https://YOUR-SITE-NAME.netlify.app

# Optional but recommended for persistent organizer event images on Netlify:
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
