PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# MongoDB Atlas database user connection string
MONGODB_URI=mongodb+srv://eventsphere_admin:<password>@cluster0.yskxqut.mongodb.net/eventsphere?retryWrites=true&w=majority

# Generate your own long random values. Never commit real secrets.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
TICKET_SIGNING_SECRET=replace_with_another_long_random_secret

REQUIRE_EVENT_APPROVAL=false

# Stage 4 project demo payment. No PAN, Razorpay account, or real money required.
PAYMENT_MODE=demo

# Leave blank for local browser verification, or set this to your LAN/deployed URL for phone QR scans.
PUBLIC_BASE_URL=http://localhost:5000

ADMIN_NAME=EventAdmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Optional ticket email delivery via Resend
# RESEND_API_KEY=replace_with_resend_api_key
# EMAIL_FROM=EventSphere <tickets@your-verified-domain.example>
